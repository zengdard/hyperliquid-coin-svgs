{
  "name": "hyperliquid-coin-svgs",
  "version": "2.0.0",
  "description": "Inline SVG icons for all HyperLiquid spot & perp assets — import directly in your app",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "assets.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./svgMap": {
      "types": "./dist/svgMap.d.ts",
      "import": "./dist/svgMap.js",
      "require": "./dist/svgMap.js",
      "default": "./dist/svgMap.js"
    },
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "import": "./dist/lazy.mjs",
      "require": "./dist/lazy.js",
      "default": "./dist/lazy.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/assets/*.d.ts",
      "import": "./dist/assets/*.js",
      "require": "./dist/assets/*.js",
      "default": "./dist/assets/*.js"
    }
  },
  "scripts": {
    "fetch": "npx tsx scripts/fetch-svgs.ts",
    "fetch:live": "npx tsx scripts/fetch-svgs.ts --live --force",
    "generate": "npx tsx scripts/fetch-svgs.ts",
    "regenerate": "npx tsx scripts/fetch-svgs.ts --cached",
    "build": "tsc && node scripts/build-lazy-esm.mjs",
    "test": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm run test"
  },
  "devDependencies": {
    "svgo": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zengdard/hyperliquid-coin-svgs.git"
  },
  "keywords": [
    "hyperliquid",
    "crypto",
    "svg",
    "icons",
    "coins",
    "cryptocurrency",
    "asset",
    "token",
    "blockchain",
    "hl",
    "perp",
    "spot"
  ]
}
